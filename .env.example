# Frontend (pre-populated in hosted environment)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend only — Hyperledger Fabric integration (local deployment)
# NEVER expose these to the browser. Keep in backend .env only.
FABRIC_ENDPOINT=localhost:7051
FABRIC_CHANNEL=mychannel
FABRIC_MSP_ID=Org1MSP
FABRIC_CERT_PATH=./crypto/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/signcerts/cert.pem
FABRIC_KEY_PATH=./crypto/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/keystore/priv_sk
FABRIC_TLS_CERT_PATH=./crypto/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
